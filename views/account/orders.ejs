<%- include('../partials/header') %>

<div class="container">
  <div class="flex-between mb-30">
    <h1 class="section-title" style="margin:0;">My Orders</h1>
    <a href="/" class="btn btn-outline"><i class="fas fa-arrow-left"></i> Continue Shopping</a>
  </div>

  <% if (orders.length > 0) { %>
    <% orders.forEach(function(order) { %>
      <a href="/account/orders/<%= order.id %>" class="order-card" style="display:block;">
        <div class="order-header">
          <span class="order-number">#<%= order.orderNumber %></span>
          <span class="order-status status-<%= order.status %>"><%= order.status %></span>
        </div>
        <div class="order-details">
          <span><i class="fas fa-calendar"></i> <%= new Date(order.createdAt).toLocaleDateString() %></span>
          <span><i class="fas fa-dollar-sign"></i> $<%= parseFloat(order.total).toFixed(2) %></span>
          <span><i class="fas fa-credit-card"></i> <%= order.paymentMethod %></span>
        </div>
        <% if (order.status === 'completed') { %>
          <div class="order-actions">
            <span class="btn btn-primary btn-sm" onclick="event.stopPropagation();window.location='/account/orders/<%= order.id %>/receipt'">
              <i class="fas fa-receipt"></i> Receipt
            </span>
          </div>
        <% } %>
      </a>
    <% }); %>
  <% } else { %>
    <div class="empty-state">
      <i class="fas fa-box-open"></i>
      <h3>No Orders Yet</h3>
      <p>You haven't placed any orders yet. Start shopping!</p>
      <a href="/" class="btn btn-primary">Browse Products</a>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
