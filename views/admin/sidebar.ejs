<div class="admin-sidebar" id="adminSidebar">
  <div class="admin-sidebar-title">Admin Panel</div>
  <a href="/admin" class="admin-nav-item <%= path === '/admin' ? 'active' : '' %>">
    <i class="fas fa-chart-bar"></i> Dashboard
  </a>
  <a href="/admin/products" class="admin-nav-item <%= path.startsWith('/admin/products') ? 'active' : '' %>">
    <i class="fas fa-box"></i> Products
  </a>
  <a href="/admin/categories" class="admin-nav-item <%= path.startsWith('/admin/categories') ? 'active' : '' %>">
    <i class="fas fa-tags"></i> Categories
