<div class="admin-sidebar" id="adminSidebar">
  <div class="admin-sidebar-title" style="display:flex;justify-content:space-between;align-items:center;padding-right:16px;">
    Admin Panel
    <button onclick="document.getElementById('adminSidebar').classList.remove('active');document.querySelector('.admin-sidebar-overlay')&&(document.querySelector('.admin-sidebar-overlay').style.opacity='0',document.querySelector('.admin-sidebar-overlay').style.pointerEvents='none')" style="background:none;border:none;color:var(--text-secondary);font-size:18px;cursor:pointer;display:none;" class="sidebar-close-btn"><i class="fas fa-times"></i></button>
  </div>
  <style>@media(max-width:768px){.sidebar-close-btn{display:block!important}}</style>
  <a href="/admin" class="admin-nav-item <%= path === '/admin' ? 'active' : '' %>">
    <i class="fas fa-chart-bar"></i> Dashboard
  </a>
  <a href="/admin/products" class="admin-nav-item <%= path.startsWith('/admin/products') ? 'active' : '' %>">
    <i class="fas fa-box"></i> Products
  </a>
  <a href="/admin/categories" class="admin-nav-item <%= path.startsWith('/admin/categories') ? 'active' : '' %>">
    <i class="fas fa-tags"></i> Categories
  </a>
  <a href="/admin/orders" class="admin-nav-item <%= path.startsWith('/admin/orders') ? 'active' : '' %>">
    <i class="fas fa-shopping-cart"></i> Orders
  </a>
  <a href="/admin/users" class="admin-nav-item <%= path.startsWith('/admin/users') ? 'active' : '' %>">
    <i class="fas fa-users"></i> Users
  </a>
  <a href="/admin/banners" class="admin-nav-item <%= path.startsWith('/admin/banners') ? 'active' : '' %>">
    <i class="fas fa-images"></i> Banners
  </a>
  <a href="/admin/tickets" class="admin-nav-item <%= path.startsWith('/admin/tickets') ? 'active' : '' %>">
    <i class="fas fa-headset"></i> Support Tickets
  </a>
  <a href="/admin/notifications" class="admin-nav-item <%= path.startsWith('/admin/notifications') ? 'active' : '' %>">
    <i class="fas fa-bell"></i> Notifications
  </a>
  <a href="/admin/settings" class="admin-nav-item <%= path.startsWith('/admin/settings') ? 'active' : '' %>">
    <i class="fas fa-cog"></i> Settings
  </a>
  <div style="border-top:1px solid var(--border-color);margin-top:20px;padding-top:10px;">
    <a href="/" class="admin-nav-item"><i class="fas fa-arrow-left"></i> Back to Site</a>
  </div>
</div>
