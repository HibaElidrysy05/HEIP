<%- include('../partials/header') %>
<div class="admin-layout">
  <%- include('sidebar') %>
  <div class="admin-content">
    <div class="admin-header">
      <h1 class="admin-title">Banners</h1>
      <button class="btn btn-outline btn-sm" id="adminToggle"><i class="fas fa-bars"></i> Menu</button>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:30px;">
      <div class="card" style="padding:25px;">
        <h3 style="margin-bottom:20px;font-weight:700;">New / Edit Banner</h3>
        <form method="POST" action="/admin/banners/save" enctype="multipart/form-data">
          <div class="form-row">
            <div class="form-group">
              <label>Type</label>
              <select name="type" class="form-select" id="bannerType">
                <option value="image">Image Banner</option>
                <option value="text">Text Banner</option>
              </select>
            </div>
            <div class="form-group">
              <label>Order</label>
              <input type="number" name="order" class="form-input" value="0">
            </div>
          </div>

          <div class="form-group">
            <label>Title</label>
            <input type="text" name="title" class="form-input" required>
          </div>

          <div class="form-group">
            <label>Content</label>
            <textarea name="content" class="form-textarea"></textarea>
          </div>

          <div id="imageUploadGroup" class="form-group">
            <label>Banner Image</label>
            <input type="file" name="image" class="form-input" accept="image/*">
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>Link URL</label>
              <input type="text" name="link" class="form-input" placeholder="https://...">
            </div>
            <div class="form-group">
              <label>Link Text</label>
              <input type="text" name="linkText" class="form-input" value="Learn More">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>Background Color</label>
              <input type="text" name="bgColor" class="form-input" value="#1a1a1a">
            </div>
            <div class="form-group">
              <label>Text Color</label>
              <input type="text" name="textColor" class="form-input" value="#ffffff">
            </div>
          </div>

          <div class="form-group">
            <label class="toggle-label">
              <input type="checkbox" name="isActive" checked> Active
            </label>
          </div>

          <button type="submit" class="btn btn-primary"><i class="fas fa-plus"></i> Add Banner</button>
        </form>
      </div>

      <div class="card" style="padding:25px;">
        <h3 style="margin-bottom:20px;font-weight:700;">Existing Banners</h3>
        <table>
          <thead><tr><th>Type</th><th>Title</th><th>Active</th><th>Order</th><th></th></tr></thead>
          <tbody>
            <% if (banners.length > 0) { %>
              <% banners.forEach(function(b) { %>
                <tr>
                  <td><span class="badge badge-<%= b.type %>"><%= b.type %></span></td>
                  <td><strong><%= b.title %></strong></td>
                  <td><%= b.isActive ? 'Yes' : 'No' %></td>
                  <td><%= b.order || 0 %></td>
                  <td>
                    <form method="POST" action="/admin/banners/delete/<%= b.id %>" onsubmit="return confirm('Delete this banner?')">
                      <button type="submit" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i></button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="5" style="text-align:center;color:var(--text-muted);">No banners yet.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
