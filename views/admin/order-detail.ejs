<%- include('../partials/header') %>
<div class="admin-layout">
  <%- include('sidebar') %>
  <div class="admin-content">
    <div class="admin-header">
      <h1 class="admin-title">Order #<%= order.orderNumber %></h1>
      <a href="/admin/orders" class="btn btn-outline btn-sm"><i class="fas fa-arrow-left"></i> Back</a>
    </div>

    <div class="card" style="padding:30px;margin-bottom:20px;">
      <div class="form-row mb-20">
        <div>
          <p style="color:var(--text-secondary);font-size:12px;text-transform:uppercase;letter-spacing:1px;">Customer</p>
          <p><strong><%= order.customerName %></strong></p>
          <p><%= order.customerEmail %></p>
        </div>
        <div>
          <p style="color:var(--text-secondary);font-size:12px;text-transform:uppercase;letter-spacing:1px;">Date</p>
          <p><%= new Date(order.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></p>
        </div>
        <div>
          <p style="color:var(--text-secondary);font-size:12px;text-transform:uppercase;letter-spacing:1px;">Payment</p>
          <p><%= order.paymentMethod %></p>
        </div>
        <div>
          <p style="color:var(--text-secondary);font-size:12px;text-transform:uppercase;letter-spacing:1px;">Receipt</p>
          <p><%= order.receiptNumber %></p>
        </div>
      </div>

      <div style="padding:20px;background:var(--bg-secondary);border-radius:var(--radius);margin-bottom:20px;">
        <form method="POST" action="/admin/orders/update-status/<%= order.id %>" class="flex gap-10" style="align-items:end;">
          <div class="form-group" style="margin:0;">
            <label style="font-size:12px;">Update Status</label>
            <select name="status" class="form-select" style="width:auto;">
              <option value="pending" <%= order.status === 'pending' ? 'selected' : '' %>>Pending</option>
              <option value="completed" <%= order.status === 'completed' ? 'selected' : '' %>>Completed</option>
              <option value="cancelled" <%= order.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
            </select>
          </div>
          <button type="submit" class="btn btn-primary btn-sm">Update</button>
        </form>
      </div>

      <h4 style="margin-bottom:15px;font-weight:600;">Items</h4>
      <table>
        <thead><tr><th>Product</th><th>Price</th><th>Qty</th><th>Total</th></tr></thead>
        <tbody>
          <% order.OrderItems.forEach(function(item) { %>
            <tr>
              <td><%= item.productTitle %></td>
              <td>$<%= parseFloat(item.price).toFixed(2) %></td>
              <td><%= item.quantity %></td>
              <td>$<%= (parseFloat(item.price) * item.quantity).toFixed(2) %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>

      <div style="text-align:right;margin-top:20px;font-size:24px;font-weight:800;">
        Total: $<%= parseFloat(order.total).toFixed(2) %>
      </div>

      <% if (order.notes) { %>
        <div style="margin-top:20px;padding:15px;background:var(--bg-secondary);border-radius:var(--radius);">
          <p style="color:var(--text-secondary);font-size:12px;text-transform:uppercase;letter-spacing:1px;margin-bottom:5px;">Notes</p>
          <p><%= order.notes %></p>
        </div>
      <% } %>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
