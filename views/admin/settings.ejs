<%- include('../partials/header') %>
<div class="admin-layout">
  <%- include('sidebar') %>
  <div class="admin-content">
    <div class="admin-header">
      <h1 class="admin-title">Settings</h1>
      <button class="btn btn-outline btn-sm" id="adminToggle"><i class="fas fa-bars"></i> Menu</button>
    </div>

    <form method="POST" action="/admin/settings" enctype="multipart/form-data">
      <div class="card" style="padding:30px;margin-bottom:20px;">
        <h3 style="margin-bottom:20px;font-weight:700;">Site Information</h3>
        <div class="form-group">
          <label>Site Name</label>
          <input type="text" name="site_name" class="form-input" value="<%= settings.site_name || 'HEIP' %>">
        </div>
        <div class="form-group">
          <label>Site Description</label>
          <textarea name="site_description" class="form-textarea"><%= settings.site_description || 'Premium digital products marketplace.' %></textarea>
        </div>
        <div class="form-group">
          <label>Logo (PNG image)</label>
          <input type="file" name="logo" class="form-input" accept="image/*">
          <% if (settings.logo) { %>
            <div style="margin-top:10px;"><img src="<%= settings.logo %>" style="max-height:50px;"></div>
          <% } %>
        </div>
      </div>

      <div class="card" style="padding:30px;margin-bottom:20px;">
        <h3 style="margin-bottom:20px;font-weight:700;">Contact Information</h3>
        <div class="form-row">
          <div class="form-group">
            <label>Contact Email</label>
            <input type="email" name="contact_email" class="form-input" value="<%= settings.contact_email || '' %>">
          </div>
          <div class="form-group">
            <label>Footer Email</label>
            <input type="email" name="footer_email" class="form-input" value="<%= settings.footer_email || '' %>">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Phone</label>
            <input type="text" name="footer_phone" class="form-input" value="<%= settings.footer_phone || '' %>">
          </div>
          <div class="form-group">
            <label>Address</label>
            <input type="text" name="footer_address" class="form-input" value="<%= settings.footer_address || '' %>">
          </div>
        </div>
        <div class="form-group">
          <label>Footer Text</label>
          <input type="text" name="footer_text" class="form-input" value="<%= settings.footer_text || '' %>">
        </div>
      </div>

      <div class="card" style="padding:30px;margin-bottom:20px;">
        <h3 style="margin-bottom:20px;font-weight:700;">Social Media</h3>
        <div class="form-row">
          <div class="form-group">
            <label>Facebook URL</label>
            <input type="text" name="social_facebook" class="form-input" value="<%= settings.social_facebook || '' %>">
          </div>
          <div class="form-group">
            <label>Twitter URL</label>
            <input type="text" name="social_twitter" class="form-input" value="<%= settings.social_twitter || '' %>">
          </div>
        </div>
        <div class="form-group">
          <label>Instagram URL</label>
          <input type="text" name="social_instagram" class="form-input" value="<%= settings.social_instagram || '' %>">
        </div>
      </div>

      <div class="card" style="padding:30px;margin-bottom:20px;">
        <h3 style="margin-bottom:20px;font-weight:700;">Legal Pages</h3>
        <div class="form-group">
          <label>About Us Text</label>
          <textarea name="about_text" class="form-textarea" style="min-height:150px;"><%= settings.about_text || '' %></textarea>
        </div>
        <div class="form-group">
          <label>Terms & Conditions</label>
          <textarea name="terms_text" class="form-textarea" style="min-height:150px;"><%= settings.terms_text || '' %></textarea>
        </div>
        <div class="form-group">
          <label>Privacy Policy</label>
          <textarea name="privacy_text" class="form-textarea" style="min-height:150px;"><%= settings.privacy_text || '' %></textarea>
        </div>
      </div>

      <button type="submit" class="btn btn-primary btn-lg"><i class="fas fa-save"></i> Save All Settings</button>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
