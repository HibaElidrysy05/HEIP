<%- include('../partials/header') %>
<div class="admin-layout">
  <%- include('sidebar') %>
  <div class="admin-content">
    <div class="admin-header">
      <h1 class="admin-title">Dashboard</h1>
      <div>
        <button class="btn btn-outline btn-sm" id="adminToggle"><i class="fas fa-bars"></i> Menu</button>
      </div>
    </div>

    <div class="stats-grid">
      <div class="stat-card"><div class="stat-value"><%= stats.products %></div><div class="stat-label">Products</div></div>
      <div class="stat-card"><div class="stat-value"><%= stats.orders %></div><div class="stat-label">Total Orders</div></div>
      <div class="stat-card"><div class="stat-value"><%= stats.pendingOrders %></div><div class="stat-label">Pending Orders</div></div>
      <div class="stat-card"><div class="stat-value"><%= stats.users %></div><div class="stat-label">Users</div></div>
      <div class="stat-card"><div class="stat-value">$<%= parseFloat(stats.revenue).toFixed(2) %></div><div class="stat-label">Revenue</div></div>
      <div class="stat-card"><div class="stat-value"><%= stats.tickets %></div><div class="stat-label">Open Tickets</div></div>
      <div class="stat-card">
        <div class="stat-value"><%= stats.unreadNotifications %></div>
        <div class="stat-label">Unread Notifications</div>
      </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:30px;">
      <div class="card" style="padding:25px;">
        <h3 style="margin-bottom:20px;font-weight:700;">Recent Orders</h3>
        <% if (recentOrders.length > 0) { %>
          <table>
            <thead><tr><th>Order</th><th>Customer</th><th>Total</th><th>Status</th><th></th></tr></thead>
            <tbody>
              <% recentOrders.forEach(function(o) { %>
                <tr>
                  <td style="font-size:12px;">#<%= o.orderNumber %></td>
                  <td><%= o.User ? o.User.username : 'N/A' %></td>
                  <td>$<%= parseFloat(o.total).toFixed(2) %></td>
                  <td><span class="badge badge-<%= o.status %>"><%= o.status %></span></td>
                  <td><a href="/admin/orders/<%= o.id %>" class="btn btn-outline btn-sm">View</a></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        <% } else { %>
          <p style="color:var(--text-muted);">No orders yet.</p>
        <% } %>
      </div>

      <div class="card" style="padding:25px;">
        <h3 style="margin-bottom:20px;font-weight:700;">Recent Notifications</h3>
        <% if (recentNotifications.length > 0) { %>
          <% recentNotifications.forEach(function(n) { %>
            <div class="notif-item <%= !n.isRead ? 'unread' : '' %>" style="border-bottom:1px solid var(--border-color);">
              <div class="notif-content">
                <div class="notif-title"><%= n.title %></div>
                <div class="notif-message"><%= n.message %></div>
                <div class="notif-time"><%= new Date(n.createdAt).toLocaleDateString() %></div>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <p style="color:var(--text-muted);">No notifications.</p>
        <% } %>
        <a href="/admin/notifications" class="btn btn-outline btn-sm mt-10">View All</a>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
