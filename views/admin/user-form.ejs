<%- include('../partials/header') %>
<div class="admin-layout">
  <%- include('sidebar') %>
  <div class="admin-content">
    <div class="admin-header">
      <h1 class="admin-title"><%= user ? 'Edit User: ' + user.username : 'New User' %></h1>
      <a href="/admin/users" class="btn btn-outline btn-sm"><i class="fas fa-arrow-left"></i> Back</a>
    </div>

    <div class="card" style="padding:30px;max-width:600px;">
      <form method="POST" action="/admin/users/save">
        <% if (user) { %>
          <input type="hidden" name="id" value="<%= user.id %>">
        <% } %>

        <div class="form-row">
          <div class="form-group">
            <label>Username</label>
            <input type="text" name="username" class="form-input" value="<%= user ? user.username : '' %>" required>
          </div>
          <div class="form-group">
            <label>Email</label>
            <input type="email" name="email" class="form-input" value="<%= user ? user.email : '' %>" required>
          </div>
        </div>

        <div class="form-group">
          <label>Full Name</label>
          <input type="text" name="fullName" class="form-input" value="<%= user ? user.fullName || '' : '' %>">
        </div>

        <div class="form-group">
          <label>Phone</label>
          <input type="text" name="phone" class="form-input" value="<%= user ? user.phone || '' : '' %>">
        </div>

        <div class="form-group">
          <label>Address</label>
          <textarea name="address" class="form-textarea"><%= user ? user.address || '' : '' %></textarea>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>Role</label>
            <select name="role" class="form-select">
              <option value="user" <%= user && user.role === 'user' ? 'selected' : '' %>>User</option>
              <option value="admin" <%= user && user.role === 'admin' ? 'selected' : '' %>>Admin</option>
            </select>
          </div>
          <div class="form-group">
            <label class="toggle-label" style="margin-top:25px;">
              <input type="checkbox" name="isActive" <%= !user || user.isActive ? 'checked' : '' %>> Active
            </label>
          </div>
        </div>

        <div class="form-group">
          <label><%= user ? 'New Password (leave blank to keep current)' : 'Password' %></label>
          <input type="password" name="password" class="form-input" minlength="6" <%= user ? '' : 'required' %>>
        </div>

        <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> <%= user ? 'Save Changes' : 'Create User' %></button>
      </form>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
