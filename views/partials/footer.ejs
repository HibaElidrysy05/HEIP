  </main>

  <footer class="footer">
    <div class="container footer-grid">
      <div class="footer-col">
        <h4>HEIP</h4>
        <p><%= siteSettings && siteSettings.site_description ? siteSettings.site_description : 'Premium digital products marketplace.' %></p>
        <% if (siteSettings && siteSettings.footer_address) { %><p><i class="fas fa-map-marker-alt"></i> <%= siteSettings.footer_address %></p><% } %>
        <% if (siteSettings && siteSettings.footer_email) { %><p><i class="fas fa-envelope"></i> <%= siteSettings.footer_email %></p><% } %>
        <% if (siteSettings && siteSettings.footer_phone) { %><p><i class="fas fa-phone"></i> <%= siteSettings.footer_phone %></p><% } %>
      </div>
      <div class="footer-col">
        <h4>Quick Links</h4>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/search">Shop</a></li>
          <li><a href="/support">Support</a></li>
          <li><a href="/cart">Cart</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Categories</h4>
        <ul>
          <% if (typeof categories !== 'undefined') { %>
            <% categories.forEach(function(cat) { %>
              <li><a href="/category/<%= cat.slug %>"><%= cat.name %></a></li>
            <% }); %>
          <% } %>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Follow Us</h4>
        <div class="social-links">
          <% if (siteSettings && siteSettings.social_facebook) { %><a href="<%= siteSettings.social_facebook %>" target="_blank"><i class="fab fa-facebook"></i></a><% } %>
          <% if (siteSettings && siteSettings.social_twitter) { %><a href="<%= siteSettings.social_twitter %>" target="_blank"><i class="fab fa-twitter"></i></a><% } %>
          <% if (siteSettings && siteSettings.social_instagram) { %><a href="<%= siteSettings.social_instagram %>" target="_blank"><i class="fab fa-instagram"></i></a><% } %>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; 2026 HEIP. All rights reserved. <%= siteSettings && siteSettings.footer_text ? siteSettings.footer_text : '' %></p>
    </div>
  </footer>

  <script src="/js/main.js"></script>
</body>
</html>
